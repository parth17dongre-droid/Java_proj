spring.application.name=Ev_charging

spring.datasource.url=jdbc:mysql://localhost:3306/springboot_db?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

jwt.secret=GENERATE_WITH_openssl_rand_base64_32
jwt.access-expiration-ms=300000
jwt.refresh-expiration-ms=1296000000

server.port=8081
# demo admin account (username "admin"); leave blank to skip creating it
seed.admin-password=CHANGE_ME_ADMIN

# paid bookings nobody starts within this many minutes are cancelled and refunded
booking.unstarted-grace-minutes=120
